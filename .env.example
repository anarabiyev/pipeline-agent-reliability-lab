# Required for real evaluation runs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1-mini

# Optional: send the curated dataset and experiments to LangSmith
LANGSMITH_API_KEY=
# Change to true when LANGSMITH_API_KEY is set.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=pipeline-recovery-agent-evaluation
# Use this endpoint if your LangSmith workspace is in the EU region.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Optional cost overrides, in USD per one million tokens.
# These example rates match GPT-4.1 Mini; update them when changing models.
INPUT_COST_PER_MILLION=0.40
CACHED_INPUT_COST_PER_MILLION=0.10
OUTPUT_COST_PER_MILLION=1.60
JUDGE_INPUT_COST_PER_MILLION=0.40
JUDGE_CACHED_INPUT_COST_PER_MILLION=0.10
JUDGE_OUTPUT_COST_PER_MILLION=1.60
